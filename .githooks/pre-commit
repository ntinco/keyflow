#!/bin/sh
# shared: gen-box/shared/githooks/pre-commit sha256:cbda84dc790d (edit it in gen-box, then run tools/contract_sync.py in gen-box)
# Shared pre-commit hook for the workspace repositories. Enable once per clone with
# `git config core.hooksPath .githooks` (tools/link_workspace.py in gen-box points it at gen-box/shared/githooks).
# The repository's .githooks/pre-commit.conf sets `check` (the health check command) and optionally `exclude`
# (one top-level path the check never reads); an executable .githooks/pre-commit.local runs after the check.
# The check runs on the staged tree (the index), so unstaged edits cannot hide what the commit contains.
set -eu
top=$(git rev-parse --show-toplevel)
cd "$top"
if [ ! -f .githooks/pre-commit.conf ]; then
    echo "pre-commit: .githooks/pre-commit.conf is missing; commit aborted" >&2
    exit 1
fi
check='' exclude=''
. ./.githooks/pre-commit.conf
staged=$(mktemp -d)
trap 'rm -rf "$staged"' EXIT
if [ -n "$exclude" ]; then
    git ls-files -z --cached -- ":(exclude)$exclude" |
        git checkout-index -z --stdin --ignore-skip-worktree-bits --prefix="$staged/"
    mkdir -p "$staged/$exclude"
else
    git checkout-index --all --ignore-skip-worktree-bits --prefix="$staged/"
fi
printf 'gitdir: %s\n' "$(git rev-parse --absolute-git-dir)" > "$staged/.git"
# Git exports GIT_INDEX_FILE relative to the top level; make it absolute so git inside "$staged" reads the real index.
GIT_INDEX_FILE=$(git rev-parse --path-format=absolute --git-path index)
export GIT_INDEX_FILE
if ! out=$(cd "$staged" && WORKSPACE_ROOT=$(dirname "$top") sh -c "$check" 2>&1); then
    printf '%s\n' "$out" >&2
    echo "pre-commit: health check failed on the staged tree; commit aborted" >&2
    exit 1
fi
if [ -x .githooks/pre-commit.local ]; then
    exec ./.githooks/pre-commit.local
fi
