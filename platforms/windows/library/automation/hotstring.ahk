class HotstringService {
  ; profile: {label, group, mode}; mode is the hotkeys.db profile mode
  ; ("replace" or "sap-command"), checked by ai/health_check.py.
  set(profile) {
    global services
    groupName := profile.group
    isSapCommand := profile.mode = "sap-command"

    if isSapCommand
      HotIf(hk => services.sap.isTextInputActive("ahk_group " groupName))
    else if groupName != ""
      HotIfWinActive("ahk_group " groupName)

    ; SAP commands always wait for an ending character so words typed in SAP
    ; fields ("datos" vs "da") do not navigate away. O swallows it: with b0
    ; alone Enter reaches SAP, which runs the raw trigger before /n<tcode> is
    ; pasted (macOS swallows it too). b0 keeps the trigger typed so SAP Easy
    ; Access can submit it as-is. ObjBindMethod keeps `this`;
    ; this._submitSapTcode.Bind(...) would shift every argument by one.
    for entry in this._loadEntries(profile.label)
    {
      if isSapCommand
        Hotstring(":XOb0:" entry["trigger"], ObjBindMethod(this, "_submitSapTcode", entry["value"], profile.label))
      else
        Hotstring((entry["immediate"] ? ":*:" : "::") entry["trigger"], entry["value"])
    }

    ; Clear the scope so hotstrings defined later in hotkeys/*.ahk are global.
    HotIf()
  }

  _submitSapTcode(tcode, profileLabel, *) {
    ; The catalog trigger is the tcode itself: in SAP Easy Access, submit
    ; what was typed instead of pasting /n<tcode>.
    if profileLabel = "sap-transaction-catalog" && InStr(WinGetTitle("A"), "SAP Easy Access")
    {
      Send("{enter}")
      return
    }
    services.sap.runTcode(tcode)
  }

  ; Generated by ai/hotkey_sync.py: {"items": [{"trigger", "value", "immediate"}]}.
  _loadEntries(label) {
    path := dataDir label ".json"
    try
    {
      jsonText := FileRead(path)
      items := jsonLoad(&jsonText)["items"]
    }
    catch as errorInfo
    {
      MsgBox("keyflow: could not load hotstrings from " path "`n" errorInfo.Message)
      return []
    }

    entries := []
    for item in items
    {
      if !(item is Map) || !item.Has("trigger") || !item.Has("value") || !item["trigger"] || !item["value"]
        continue
      item["immediate"] := item.Has("immediate") && item["immediate"]
      entries.Push(item)
    }
    return entries
  }
}
