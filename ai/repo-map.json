{
  "version": 6,
  "purpose": "Navigation map for rapid dual-role AI maintenance of keyflow.",
  "guide-files": {
    "summary": "ai/health-check.summary.json",
    "map": "ai/repo-map.json",
    "rules": "AGENTS.md",
    "architecture": "README.md"
  },
  "read-order": [
    "ai/health-check.summary.json",
    "ai/repo-map.json",
    "AGENTS.md",
    "README.md",
    "ai/current-plan.md",
    "ai/governance.json",
    "ai/prompts/agent-prompts.md",
    "ai/prompts/executor-prompt.md",
    "ai/prompts/architect-prompt.md",
    "ai/prompts/planner-prompt.md",
    "ai/catalog-review.json",
    "ai/run_smoke.py",
    "platforms/windows/keyflow.ahk",
    "platforms/windows/library/bootstrap.ahk",
    "platforms/windows/library/automation/sap.ahk"
  ],
  "plan-location": {
    "default": "AGENTS.md -> Next evolution frontier",
    "detailed": "ai/current-plan.md",
    "rule": "Use at most one persistent detailed plan file at a time. Do not create root-level plan files."
  },
  "entrypoints": [
    {
      "id": "runtime",
      "path": "platforms/windows/keyflow.ahk",
      "role": "Main AutoHotkey entrypoint."
    },
    {
      "id": "bootstrap",
      "path": "platforms/windows/library/bootstrap.ahk",
      "role": "Loads constants, free util functions, services, and hotstring profiles."
    },
    {
      "id": "startup-host",
      "path": "platforms/windows/tools/startup/host-startup.ahk",
      "role": "Optional host launcher."
    },
    {
      "id": "health-check",
      "path": "ai/health_check.py",
      "role": "Validation guard and machine-readable state generator."
    },
    {
      "id": "review-check",
      "path": "ai/review_check.py",
      "role": "Reviewer-oriented audit for cycle closure, guide alignment, and handoff quality."
    }
  ],
  "domains": [
    {
      "id": "sap-automation",
      "path": "platforms/windows/library/automation/sap.ahk",
      "owns": [
        "public services.sap facade",
        "SAP GUI automation",
        "Eclipse ABAP helpers",
        "tcode execution",
        "code-save and quick debug helpers"
      ]
    },
    {
      "id": "runtime-services",
      "path": "platforms/windows/library/automation/",
      "owns": [
        "6 registered services exposed as services.*"
      ]
    },
    {
      "id": "util",
      "path": "platforms/windows/library/util.ahk",
      "owns": [
        "free utility functions only"
      ]
    },
    {
      "id": "hotkeys",
      "path": "platforms/windows/hotkeys/",
      "owns": [
        "generated triggers from hotkeys.db",
        "global triggers",
        "SAP GUI triggers",
        "SAP Eclipse triggers",
        "domain triggers",
        "standalone layout script"
      ]
    },
    {
      "id": "catalogs",
      "path": "platforms/windows/data/",
      "owns": [
        "versioned catalogs (autocorrect, quick-snippets, sap-transaction-catalog, sap-transaction-shortcuts, ymt-commands)",
        "example config contracts"
      ]
    },
    {
      "id": "shared-catalogs",
      "path": "platforms/shared/data/",
      "owns": [
        "human-managed hotkeys.db (drives both the Windows AHK runtime and the macOS Hammerspoon runtime)"
      ]
    },
    {
      "id": "startup",
      "path": "platforms/windows/tools/startup/",
      "owns": [
        "secondary launchers for host and VMware contexts"
      ]
    },
    {
      "id": "ai-tooling",
      "path": "ai/",
      "owns": [
        "hotkey_sync.py",
        "health_check.py",
        "review_check.py",
        "run_smoke.py",
        "health-check.summary.json",
        "health-check.json",
        "run-result.json",
        "run-result.example.json",
        "repo-map.json",
        "current-plan.md",
        "agent-prompts.md",
        "executor-prompt.md",
        "architect-prompt.md",
        "planner-prompt.md",
        "governance.json",
        "catalog-review.json"
      ]
    },
    {
      "id": "macos-hammerspoon",
      "path": "platforms/macos/hammerspoon/",
      "owns": [
        "init.lua entrypoint",
        "actions.lua (hand-authored hotkey behavior)",
        "hotstrings.lua (hs.eventtap watcher)",
        "generated/bindings.lua (binding metadata generated from hotkeys.db)"
      ]
    }
  ],
  "runtime-api": [
    "hotstring",
    "launcher",
    "sap",
    "snipaste",
    "windowGroup",
    "windows"
  ],
  "startup-config-sections": [
    "runtime-env",
    "sap-delays"
  ],
  "local-only-files": [
    "ai/run-result.json",
    "platforms/windows/data/hotkey-usage.json",
    "platforms/windows/data/local-secrets.ini",
    "platforms/windows/data/local-paths.ini",
    "platforms/windows/data/local-startup.ini",
    "platforms/windows/data/memory-vars.ini",
    "platforms/windows/data/rom.ini",
    "storage.db",
    "platforms/windows/storage.db"
  ],
  "standalone": [
    "platforms/windows/hotkeys/layouts/colemak-dh.ahk"
  ],
  "current-focus": "Stable reduced Windows runtime with 22 hotkeys, 6 focused service surfaces, free utility helpers for value and command resolution, no credential-provider dependency, no hotkey usage tracking, explicit portability classification, and selected SAP/ADT workflows.",
  "next-frontier": "macOS first vertical slice (Hammerspoon: platforms/macos/hammerspoon/, 3 Eclipse/ADT hotkeys + 6 hotstrings) is implemented and human-verified working on real hardware. No technical work is pending on this slice. A next macOS slice (candidates: snipaste_enter, or SAP GUI for Java hotkeys) requires a new architect decision; see ai/current-plan.md."
}
