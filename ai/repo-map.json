{
  "schema_version": "1.0",
  "purpose": "AI-operated personal automation runtime",
  "routing": {
    "governance": "ai/governance.md",
    "windows": {
      "entrypoint": "platforms/windows/keyflow.ahk",
      "bootstrap": "platforms/windows/library/bootstrap.ahk",
      "services": "platforms/windows/library/automation/",
      "hotkeys": "platforms/windows/hotkeys/",
      "catalogs": "platforms/windows/data/",
      "selftest": "platforms/windows/tools/selftest.ahk"
    },
    "macos": {
      "entrypoint": "platforms/macos/hammerspoon/init.lua",
      "actions": "platforms/macos/hammerspoon/actions.lua",
      "hotstrings": "platforms/macos/hammerspoon/hotstrings.lua",
      "dispatch": "platforms/macos/hammerspoon/dispatch.lua",
      "clipboard": "platforms/macos/hammerspoon/clipboard.lua",
      "generated": "platforms/macos/hammerspoon/generated/"
    },
    "shared": {
      "hotkeys": "platforms/shared/data/hotkeys.db",
      "catalog_review": "ai/catalog-review.json"
    },
    "validation": {
      "health": "ai/health_check.py",
      "hotkey_sync": "ai/hotkey_sync.py",
      "smoke": "ai/run_smoke.py",
      "tests": "ai/tests/"
    },
    "conditional": {
      "active_work": "ai/current-plan.md"
    }
  },
  "ownership": {
    "human_owned": [
      "platforms/shared/data/hotkeys.db",
      "ai/catalog-review.json"
    ],
    "generated_versioned": [
      "platforms/windows/hotkeys/",
      "platforms/windows/data/*.json",
      "platforms/macos/hammerspoon/generated/"
    ],
    "generated_local": [
      "ai/health-check.json",
      "ai/health-check.summary.json",
      "ai/run-result.json",
      "ai/run-result-macos.json"
    ]
  },
  "local_only": [
    "ai/health-check.json",
    "ai/health-check.summary.json",
    "ai/run-result.json",
    "ai/run-result-macos.json",
    "platforms/windows/data/local-secrets.ini",
    "platforms/windows/data/local-startup.ini",
    "platforms/shared/data/memory-vars.ini",
    "platforms/shared/data/local-paths.ini",
    "platforms/windows/data/rom.ini",
    "storage.db",
    "platforms/windows/storage.db"
  ],
  "validators": [
    "python ai/health_check.py --pretty",
    "python ai/hotkey_sync.py --check",
    "python -m unittest discover -s ai/tests",
    "python ai/run_smoke.py --platform windows",
    "python ai/run_smoke.py --platform macos"
  ]
}
